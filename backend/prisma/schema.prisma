// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////
// ENUMS
//////////////////////////

enum Role {
  ADMIN
  FINANCE
  OPERATION
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CustomerType {
  XANAANO
  SCHOOL
  INDIVIDUAL
}

enum Gender {
  MALE
  FEMALE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

//////////////////////////
// USERS TABLE
//////////////////////////

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  role      Role     @default(USER)
  resetToken String?
  resetExpiry DateTime?
  createdAt DateTime @default(now())
}

//////////////////////////
// CUSTOMERS TABLE
//////////////////////////

model Customer {
  id             String        @id @default(uuid())
  name           String
  phone          String?
  email          String?
  type           CustomerType
  contactPerson  String?
  city           String?
  status         UserStatus    @default(ACTIVE)

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

//////////////////////////
// DEPARTMENTS TABLE
//////////////////////////

model Department {
  id          String      @id @default(uuid())
  name        String      @unique
  description String?

  employees   Employee[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

//////////////////////////
// EMPLOYEES TABLE
//////////////////////////

model Employee {
  id             String          @id @default(uuid())
  fullName       String
  gender         Gender
  email          String?         @unique
  phone          String?
  salary         Float?
  hireDate       DateTime
  jobTitle       String
  employmentType EmploymentType
  status         EmployeeStatus  @default(ACTIVE)

  department     Department      @relation(fields: [deptId], references: [id])
  deptId         String

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}
//////////////////////////////////////////////////////
// 1️⃣ WAREHOUSE
//////////////////////////////////////////////////////

model Warehouse {
  id        Int      @id @default(autoincrement())
  name      String
  location  String?
  createdAt DateTime @default(now())

  stock     InventoryStock[]
  movements InventoryMovement[]
  sales     SalesOrder[]
}

//////////////////////////////////////////////////////
// 2️⃣ PRODUCT
//////////////////////////////////////////////////////

model Product {
  id          Int      @id @default(autoincrement())
  sku         String   @unique
  name        String
  price       Decimal  @db.Decimal(18,2)
  createdAt   DateTime @default(now())

  stock       InventoryStock[]
  movements   InventoryMovement[]
  salesItems  SalesOrder[]
}

//////////////////////////////////////////////////////
// 3️⃣ INVENTORY STOCK (Current Quantity)
//////////////////////////////////////////////////////

model InventoryStock {
  id             Int      @id @default(autoincrement())
  warehouseId    Int
  productId      Int
  quantityOnHand Decimal  @db.Decimal(18,4) @default(0)

  warehouse      Warehouse @relation(fields: [warehouseId], references: [id])
  product        Product   @relation(fields: [productId], references: [id])

  @@unique([warehouseId, productId])
}

//////////////////////////////////////////////////////
// 4️⃣ INVENTORY MOVEMENT (Stock Ledger)
//////////////////////////////////////////////////////

model InventoryMovement {
  id           Int      @id @default(autoincrement())
  productId    Int
  warehouseId  Int
  movementType String   // PURCHASE | SALE | ADJUSTMENT
  quantity     Decimal  @db.Decimal(18,4)
  unitPrice    Decimal? @db.Decimal(18,2)
  createdAt    DateTime @default(now())

  product      Product   @relation(fields: [productId], references: [id])
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id])
}

//////////////////////////////////////////////////////
// 5️⃣ SALES ORDER (Simple version)
//////////////////////////////////////////////////////

model SalesOrder {
  id          Int      @id @default(autoincrement())
  productId   Int
  warehouseId Int
  quantity    Decimal  @db.Decimal(18,4)
  totalAmount Decimal  @db.Decimal(18,2)
  createdAt   DateTime @default(now())

  product     Product   @relation(fields: [productId], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
}